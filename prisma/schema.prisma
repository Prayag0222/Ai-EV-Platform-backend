datasource db {
  provider = "postgresql"
  // ◄ The 'url' line was completely removed from here!
}

generator client {
  provider = "prisma-client-js" // Industry standard for Prisma 7
  output   = "../src/generated/client"
}

enum Role {
  USER
  OWNER
  TECHNICIAN
}

enum TechnicianStatus {
  AVAILABLE
  BUSY
  ON_LEAVE
}

enum TicketStatus {
  PENDING
  DIAGNOSING
  IN_SERVICE
  RESOLVED
  DELIVERED
}

enum TicketPriority {
  LOW
  STANDARD
  HIGH
  URGENT
}

enum TechnicianSpecialization {
  BATTERY
  BMS
  CONTROLLER
  MOTOR
  GENERAL
}

enum SaleType {
  REPAIR
  COUNTER
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  name        String
  password    String
  role        Role     @default(USER)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt


  shop shop?

  @@map("users")
}




model customer {
  id        String   @id @default(uuid())
  name      String
  email     String?
  phone     String  
   @@unique([shopId,phone])
  address   String?
  createdAt DateTime @default(now())

  // ⚡ LINK ROW: Points to our lowercase repairTicket model
  tickets  repairTicket[]
  vehicles Vehicle[] // ⚡ ADDED: Connects the customer directly to their garage profile

shopId  String
shop    shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
}

model repairTicket {
  id            Int            @id @default(autoincrement())
  issueCategory String // e.g., "Battery", "BMS", "Controller"
  description   String // Customer's initial complaint
  status        TicketStatus   @default(PENDING) // PENDING, DIAGNOSING, IN_SERVICE, RESOLVED
  bay           String?
  priority      TicketPriority @default(STANDARD) // Urgent, Standard

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  closedAt DateTime?

  estimatedCost Float?

  finalCost Float?

  laborHours Float @default(0)
  laborRate  Float @default(0)
  taxRate    Float @default(0)
  discount   Float @default(0)

  aiSummary    String?
  manufacturer String?

  // Core Relations
  customerId String
  customer   customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  technicianId String?
  technician   technician? @relation(fields: [technicianId], references: [id], onDelete: SetNull)

  vehicleId Int? // ⚡ ADDED: Links this specific active ticket to a vehicle profile
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

shopId  String
shop    shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

aiConversation aiConversation?

diagnosticState Json?

  // ⚡ NEW MOBILE-FIRST RELATIONS
  notes    technicianNote[]
  timeline timelineEvent[]
  parts    usedPart[]
  invoice  invoice?
}

model technicianNote {
  id        Int          @id @default(autoincrement())
  ticketId  Int
  ticket    repairTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  aiSummary String?

  // AI Voice-to-Text Engine Fields
  rawVoiceText   String? // E.g., "BMS kharab tha..."
  structuredText String // E.g., "BMS failure detected and replaced."

  // Quick Tap Tags and Media
  quickTags String[] // PostgreSQL supports arrays: ["BMS", "Fuse"]
  imageUrls String[] // ["https://aws-s3-bucket/image1.jpg"]

  createdAt DateTime @default(now())
}

model timelineEvent {
  id       Int          @id @default(autoincrement())
  ticketId Int
  ticket   repairTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  status    String // What status did it change to? (e.g., "In Service")
  createdAt DateTime @default(now()) // Automatically logs the exact time!
}

model usedPart {
  id Int @id @default(autoincrement())

  // Link to the specific repair job
  ticketId Int
  ticket   repairTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  // Link directly to your EXISTING Owner Inventory system!
  inventoryId   Int
  inventoryItem inventory @relation(fields: [inventoryId], references: [id])

  // Store the specific details of THIS transaction
  quantity   Int   @default(1)
  lockedCost Float // We copy the cost here so it never changes on old invoices!

  createdAt DateTime @default(now())
}

model inventory {
  id            Int    @id @default(autoincrement())
  partName      String // e.g., "Ather 450X Brake Pads"
  sku           String
   @@unique([shopId, sku])
  category      String // e.g., "Electrical", "Consumables", "Drivetrain"
  stockLevel    Int    @default(0) // How many are on the shelf right now
  retailPrice   Float // What the customer pays on the final invoice
  lowStockAlert Int    @default(5) // Triggers the UI warning when stock dips below this number

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
shopId  String
shop    shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  // ⚡ LINK ROW: Points to our usedPart history
  usageHistory usedPart[]
}

model invoice {
  id              Int      @id @default(autoincrement())
  invoiceNo       String   @unique
  shopName        String?  @default("VoltOps")
  shopAddress     String?  @default("")
  gstNumber       String?
  customerName    String
  customerAddress String   @default("")
  customerPhone   String
  items           Json
  laborCharge     Float    @default(0.0)
  tax             Float    @default(0.0)
  discount        Float    @default(0.0)
  grandTotal      Float
  paymentStatus   String   @default("UNPAID")
  paymentMethod   String   @default("NONE")
  notes           String   @default("")
  saleType        SaleType

  ticketId Int?          @unique
  ticket   repairTicket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)

   shopId  String
  shop    shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model technician {
  id              String                   @id @default(uuid())
  fullName        String
  email           String  
  @@unique([shopId, email])              
  phone           String
  employeeId      String                  
  @@unique([shopId, employeeId])
  specialization  TechnicianSpecialization
  status          TechnicianStatus         @default(AVAILABLE)
  experienceYears Int
  address         String?
  profileImage    String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt


  shopId  String
  shop    shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  tickets repairTicket[]
}

model Vehicle {
  id           Int    @id @default(autoincrement())
  vin          String @unique // Filled by Owner
  vehicleModel String // Filled by Owner (e.g., "Ather 450X")

  // 🛠️ ADVANCED TELEMETRY FIELDS (Filled/Updated by Technician on the shop floor)
  batteryPackSerial  String?
  batteryCapacity    String?
  batterySoh         Int?
  batteryCycles      Int?
  batteryTemp        String?
  odometer           String?
  lastServiceDate DateTime?
  manufacturer       String?
  modelYear Int?
  motorSerial String?
  motorType String?
  motorNotes String?

  controllerSerial String?
  controllerVersion String?
  controllerNotes String?


  healthScore Int?

  lastAiCheck DateTime?

  // Relations

  customerId String // ⚡ FIXED: Shifted from Int to String to match uuid()
  customer   customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  shopId  String
  shop    shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  tickets    repairTicket[] // ⚡ FIXED: Mapped straight to the correct repairTicket model
}

model shop {
  id          String  @id @default(uuid())
  shopName    String
  shopAddress String?
  gstNumber   String?
  shopPhone   String?

  // ✅ ADD THESE
  ownerId     String  @unique
  owner       User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  // ✅ ADD BACK-RELATIONS for all child models
  customers    customer[]
  technicians  technician[]
  tickets      repairTicket[]
  vehicles     Vehicle[]
  inventory    inventory[]
  invoice      invoice[]
}

model aiConversation {
  id        String   @id @default(uuid())
  ticketId  Int      @unique
  ticket    repairTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  messages  aiMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model aiMessage {
  id             String   @id @default(uuid())
  conversationId String
  conversation   aiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role      String
  content   String

  createdAt DateTime @default(now())
}